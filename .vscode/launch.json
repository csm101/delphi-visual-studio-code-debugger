{
    // Launch configurations for THIS repository's own sample target.
    //
    // The Delphi IDE plugin writes its own configurations into the
    // `launch` section of the .code-workspace file, honouring the project's
    // ACTIVE platform -- so a project built for Win32 gets a Win32 launch
    // config there. Those appear in the dropdown tagged "(workspace)"; the
    // ones below are tagged with the folder name. Do not add diagnostic or
    // one-off experiment configurations here: they crowd out the plugin's
    // entries, and VS Code offers the FIRST configuration in the list until
    // the user picks one explicitly (the selection lives in workspace state,
    // not in any file, so nothing here can set it).
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Debugme (Delphi DAP)",
            "type": "delphi-win64",
            "request": "launch",
            "program": "${workspaceFolder}/Win64/Debug/Debugme.exe",
            "mapFile": "${workspaceFolder}/Win64/Debug/Debugme.map",
            "sourceRoot": "${workspaceFolder}",
            "sourceSearchPaths": [
                "${env:BDS}/source"
            ],
            "stopAtEntry": true
        },
        {
            "name": "Debug Debugme + TestPlugin (BPL test)",
            "type": "delphi-win64",
            "request": "launch",
            "program": "${workspaceFolder}/Win64/Debug/Debugme.exe",
            "mapFile": "${workspaceFolder}/Win64/Debug/Debugme.map",
            "sourceRoot": "${workspaceFolder}",
            "stopAtEntry": false,
            "modules": [
                {
                    "name": "testplugin.dll",
                    "map": "${workspaceFolder}/Win64/Debug/TestPlugin.map"
                }
            ]
        },
        {
            // Kept only until the exception-kind gate has been confirmed by
            // hand in the GUI (TASK_RESUME.md, verification item 3): a Delphi
            // `raise` two nested procedures deep, where the plumbing above the
            // raise site IS trimmed, so the Call Stack must open ON the raise
            // (RnInner, TestTargetCore.pas). Delete once confirmed -- the
            // behaviour itself is covered by the suite.
            "name": "Delphi raise: deep nested (TestTarget)",
            "type": "delphi-win64",
            "request": "launch",
            "program": "${workspaceFolder}/DebuggerTests/TestTarget/Win64/Debug/TestTarget.exe",
            "args": ["--run-deep-nested-raise"],
            "sourceRoot": "${workspaceFolder}/DebuggerTests/TestTarget",
            "stopAtEntry": false,
            "diagnosticLog": true
        }
    ]
}

// VS Code workspace for the Delphi Win64 debugger itself.
//
// Open THIS file rather than the folder: the Delphi LSP extension and the build
// tasks are configured here. Every path is relative to ${workspaceFolder}, so it
// works wherever the repository is cloned.
{
    "folders": [
        {
            "path": "."
        },
        {
            "path": "DebuggerCore"
        },
        {
            "path": "VisualStudioCodeDelphiDebugger"
        },
        {
            "path": "MCPDebugger"
        }
    ],
    "settings": {
        "files.exclude": {
            "**/Debug": true,
            "**/Release": true,
            "**/Win32/Debug": true,
            "**/Win32/Release": true,
            "**/Win64/Debug": true,
            "**/Win64/Release": true,
            "**/__recovery": true,
            "**/__history": true,
            "**/*.res": true,
            "**/*.RES": true,
            "**/*.bak": true
        },
        "files.trimTrailingWhitespace": true,
        "editor.detectIndentation": false,
        "editor.tabSize": 2,
        "editor.foldingMaximumRegions": 8000,
        "diffEditor.ignoreTrimWhitespace": false,
        // The debugger supports breakpoints in files VS Code does not recognise
        // as a debuggable language, which is most .pas files without the LSP.
        "debug.allowBreakpointsEverywhere": true,
        "[objectpascal]": {
            "editor.language.brackets": [
                ["begin", "end"],
                ["case", "end"],
                ["repeat", "until"],
                ["try", "end"],
                ["while", "do"],
                ["if", "then"],
                ["for", "do"]
            ]
        },
        // Markdown keeps its trailing whitespace: two spaces are a line break.
        "[markdown]": {
            "files.trimTrailingWhitespace": false,
            "editor.trimAutoWhitespace": false
        },
        // The Delphi LSP reads its compiler options from this file. Some
        // versions of the extension insist on an absolute `file:///` URI; if
        // completion stays silent, set one in your own user settings rather
        // than editing this shared file.
        "delphiLsp.settingsFile": "${workspaceFolder}/Debugme.delphilsp.json"
    },
    "extensions": {
        "recommendations": [
            "embarcaderotechnologies.delphilsp"
        ]
    },
    "launch": {
        "version": "0.2.0",
        "configurations": [
            {
                "type": "delphi-win64",
                "request": "launch",
                "name": "Debug Debugme (the sample target)",
                "program": "${workspaceFolder}/Win64/Debug/Debugme.exe",
                "mapFile": "${workspaceFolder}/Win64/Debug/Debugme.map",
                "rsmFile": "${workspaceFolder}/Win64/Debug/Debugme.rsm",
                "sourceRoot": "${workspaceFolder}",
                "stopOnEntry": false
            }
        ]
    },
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "Build Debugme (Debug Win64)",
                "type": "shell",
                "command": "cmd",
                "args": [
                    "/c",
                    "rsvars.bat && msbuild Debugme.dproj /t:Build /p:Config=Debug;Platform=Win64 /nologo"
                ],
                "options": {
                    "cwd": "${workspaceFolder}"
                },
                "presentation": {
                    "reveal": "always",
                    "panel": "shared"
                },
                "problemMatcher": {
                    "owner": "delphi",
                    "fileLocation": "absolute",
                    "pattern": {
                        "regexp": "^(.+)\\((\\d+)\\)\\s+(Fatal|Error|Warning|Hint):\\s+[A-Z]\\d+\\s+(.+)$",
                        "file": 1,
                        "line": 2,
                        "severity": 3,
                        "message": 4
                    }
                },
                "group": {
                    "kind": "build",
                    "isDefault": true
                }
            },
            {
                "label": "Build the debug adapter (Debug Win64)",
                "type": "shell",
                "command": "cmd",
                "args": [
                    "/c",
                    "${workspaceFolder}\\build_dap.bat"
                ],
                "options": {
                    "cwd": "${workspaceFolder}"
                },
                "presentation": {
                    "reveal": "always",
                    "panel": "shared"
                },
                "problemMatcher": {
                    "owner": "delphi",
                    "fileLocation": "absolute",
                    "pattern": {
                        "regexp": "^(.+)\\((\\d+)\\)\\s+(Fatal|Error|Warning|Hint):\\s+[A-Z]\\d+\\s+(.+)$",
                        "file": 1,
                        "line": 2,
                        "severity": 3,
                        "message": 4
                    }
                },
                "group": "build"
            },
            {
                "label": "Build the MCP server (Debug Win64)",
                "type": "shell",
                "command": "cmd",
                "args": [
                    "/c",
                    "${workspaceFolder}\\build_mcp.bat"
                ],
                "options": {
                    "cwd": "${workspaceFolder}"
                },
                "presentation": {
                    "reveal": "always",
                    "panel": "shared"
                },
                "problemMatcher": {
                    "owner": "delphi",
                    "fileLocation": "absolute",
                    "pattern": {
                        "regexp": "^(.+)\\((\\d+)\\)\\s+(Fatal|Error|Warning|Hint):\\s+[A-Z]\\d+\\s+(.+)$",
                        "file": 1,
                        "line": 2,
                        "severity": 3,
                        "message": 4
                    }
                },
                "group": "build"
            },
            {
                "label": "Run the integration test suite",
                "type": "shell",
                "command": "cmd",
                "args": [
                    "/c",
                    "${workspaceFolder}\\DebuggerTests\\build_and_run.bat"
                ],
                "options": {
                    "cwd": "${workspaceFolder}"
                },
                "presentation": {
                    "reveal": "always",
                    "panel": "shared"
                },
                "problemMatcher": [],
                "group": "test"
            }
        ]
    }
}

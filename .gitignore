# Delphi compiled output
*.exe
*.dll
*.bpl
*.bpi
*.dcp
*.dcu
*.obj
*.o
*.res
*.rsm
*.map
*.pdb
*.drc
*.cmds

# Delphi IDE files
*.dsk
*.~dsk
*.dsv
*.local
*.identcache
*.skincfg
*.delphilsp.json
__history/
*.stat


# Delphi project locals
*.dproj.local
*.dproj.localcfg
*.groupproj.local

# VS Code workspace state
.vscode/settings.json

# Dropped here by the Delphi IDE plugin (EditInVsCodeDelphiPlugin) when it
# generates a workspace. It is the plugin's own team-defaults file, meant to be
# versioned in the projects it generates FOR, not in this repository.
vscode-workspace-defaults.json

# any local developer settings
*.local.json

# Transient worktrees created by Claude Code agents running in isolation.
# Each one is a full checkout of the repository; committing it would nest a copy
# of the repo inside itself. Agent definitions in .claude/agents/ are deliberate
# and stay tracked.
.claude/worktrees/


# Distributable setup zip (regenerated by build_setup_zip.bat)
dist/

# Log files
*.log

# Symbol sidecar indexes (regenerated on demand by the adapter/test run)
*.idx

# Test runner output (regenerated on every run)
TestResults.xml
TestResults_filt.xml
dunitx-results.xml
DebuggerTests/Win64/

# RsmAnalyzer outputs (regenerated on demand)
*.analysis.txt
*.strings.txt
*.hex.txt
*.jdbg
# External TD32 debug symbols (dcc64 -VT), a build artifact like .map/.rsm
*.tds

# Live findings from debugging a real third-party application: local notes only.
MCP_LIVE_FINDINGS_TODO.md

# Delphi regenerates most .res files, but Debugme.res is the sample target's
# project resource: without it a fresh clone cannot compile Debugme.dpr, whose
# {$R *.res} refers to it.
!Debugme.res

# Zydis (disassembler dependency): the built DLL is committed on purpose so
# build_all.bat / build_dap.bat stay Delphi-only (see ThirdParty/Zydis/PROVENANCE.md).
# The CMake scratch directory build_zydis.bat regenerates it into stays ignored.
!ThirdParty/Zydis/bin/x64/*.dll
ThirdParty/Zydis/build/

# Staged copies of the Zydis MIT licence text (DISASSEMBLY_PLAN.md increment
# 7): update-install.bat / install\Install.dpr / build_setup_zip.bat copy it
# alongside the DLL next to each installed adapter/MCP server, from the one
# tracked source ThirdParty/Zydis/LICENSE. The DLL copies are already covered
# by the *.dll rule above; this is the same treatment for its licence file.
Zydis-LICENSE.txt
